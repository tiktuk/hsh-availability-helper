{
  "manifest_version": 3,
  "name": "HSH-Helper",
  "version": "1.0.0",
  "description": "Fill availability in whole tour blocks, label the icon sidebar, overlay your own iCal calendar, and print the monthly invoice.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://hsh.gomus.de/*"],
  "optional_host_permissions": ["*://*/*"],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://hsh.gomus.de/guide/*"],
      "js": ["content/ical.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
